# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local MongoDB: mongodb://localhost:27017/resilient_decision_system
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/resilient_decision_system?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/resilient_decision_system
USE_MEMORY_DB_FALLBACK=true

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Resilience & Retries
EXTERNAL_SERVICE_TIMEOUT_MS=3000
EXTERNAL_SERVICE_FAILURE_RATE=0.0
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=2000

# Security & CORS
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
