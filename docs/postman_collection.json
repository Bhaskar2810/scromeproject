{
  "info": {
    "name": "Resilient Decision System API",
    "description": "Comprehensive Postman Collection for Resilient Workflow Decision Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "authToken", "value": "" },
    { "key": "requestId", "value": "REQ-DEMO-001-AUTO-APPROVED" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Reviewer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"reviewer\",\n  \"password\": \"ReviewerPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Intake (Auto-Approve Scenario 1)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workflowCode\": \"APPLICATION_APPROVAL\",\n  \"idempotencyKey\": \"IDEMP-SCENARIO-001\",\n  \"payload\": {\n    \"applicantName\": \"Alice Green\",\n    \"amount\": 35000,\n    \"income\": 85000,\n    \"documents\": {\n      \"idProof\": \"DOC-PASSPORT-4412\"\n    }\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/requests", "host": ["{{baseUrl}}"], "path": ["requests"] }
          }
        },
        {
          "name": "Intake (Manual Review Scenario 3)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workflowCode\": \"APPLICATION_APPROVAL\",\n  \"idempotencyKey\": \"IDEMP-SCENARIO-003\",\n  \"payload\": {\n    \"applicantName\": \"Charlie Underwriter Review\",\n    \"amount\": 120000,\n    \"income\": 95000,\n    \"documents\": {\n      \"idProof\": \"DOC-DL-9912\"\n    }\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/requests", "host": ["{{baseUrl}}"], "path": ["requests"] }
          }
        },
        {
          "name": "List Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["requests"] }
          }
        },
        {
          "name": "Get Request by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}"] }
          }
        },
        {
          "name": "Get Decision Explanation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}/explanation", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}", "explanation"] }
          }
        }
      ]
    },
    {
      "name": "Manual Review",
      "item": [
        {
          "name": "Get Review Queue",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/reviews", "host": ["{{baseUrl}}"], "path": ["reviews"] }
          }
        },
        {
          "name": "Approve Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Income verified via recent tax return. Approved.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reviews/{{requestId}}/approve", "host": ["{{baseUrl}}"], "path": ["reviews", "{{requestId}}", "approve"] }
          }
        }
      ]
    },
    {
      "name": "System & Chaos",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Dependency Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/dependencies/status", "host": ["{{baseUrl}}"], "path": ["dependencies", "status"] }
          }
        },
        {
          "name": "Configure Chaos Mode",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"forceMode\": \"INTERMITTENT\",\n  \"failureRate\": 0.2,\n  \"timeoutMs\": 3000\n}"
            },
            "url": { "raw": "{{baseUrl}}/dependencies/chaos", "host": ["{{baseUrl}}"], "path": ["dependencies", "chaos"] }
          }
        }
      ]
    }
  ]
}
